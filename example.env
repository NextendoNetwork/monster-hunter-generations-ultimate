# monster-hunter-generations-ultimate — example configuration.
# Copy to ".env" and fill in real values. NEVER commit your real .env.

# --- Network ---
# Bare public IP clients dial (baked into the secure station URL), not host:port.
NEXTENDO_HOST=127.0.0.1
AUTH_PORT=443
SECURE_PORT=60016
NEXTENDO_PROXY_PROTOCOL=0

# --- TLS ---
CERT_FILE=cert.pem
KEY_FILE=key.pem

# --- P2P NAT bridging: must be the file nncs-server writes ---
NNCS_NAT_FILE=/nat/nat_endpoints.txt

# --- Nextendo account integration ---
NEXTENDO_ACCOUNT_URL=http://nextendo-account:8080
NEXTENDO_REQUIRE_ACCOUNT=1
NEXTENDO_REQUIRE_SIGNED_TOKEN=1
# Exact "tv" claim required from emulator logins (e.g. 1.4.0); empty = no check.
NEXTENDO_REQUIRED_VERSION=
# Rejection code for a wrong version: empty (2306-0819) | unsupported | clientold | tokenparse
NEXTENDO_VERSION_REJECT_CODE=

# --- Session housekeeping ---
NEXTENDO_AUTH_RECALL_FILE=auth_recall.json
NEXTENDO_REAP_IDLE_SECONDS=600

# --- Secrets (set these to strong random values in production) ---
NEXTENDO_INTERNAL_KEY=change-me
# Token-signing secret: set the value directly, or point to the shared key file.
NEXTENDO_SECRET=
NEXTENDO_SECRET_FILE=nextendo_secret.key
# Kerberos password shared between the auth and secure endpoints.
NEXTENDO_SECURE_PASSWORD=change-me

# --- Monitoring dashboard (fail-closed without a token) ---
DASH_PORT=8101
DASH_TOKEN=change-me
