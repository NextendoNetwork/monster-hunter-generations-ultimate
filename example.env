# monster-hunter-generations-ultimate — example configuration.
# Copy to ".env" and fill in real values. NEVER commit your real .env.

# --- Network ---
NEXTENDO_HOST=0.0.0.0
NEXTENDO_PROXY_PROTOCOL=0

# --- Nextendo account integration ---
NEXTENDO_ACCOUNT_URL=https://nextendo.network
NEXTENDO_REQUIRE_ACCOUNT=1
NEXTENDO_REQUIRE_SIGNED_TOKEN=0

# --- Secrets (set these to strong random values in production) ---
NEXTENDO_INTERNAL_KEY=change-me
NEXTENDO_SECRET=change-me
NEXTENDO_SECRET_FILE=
NEXTENDO_SECURE_PASSWORD=change-me
